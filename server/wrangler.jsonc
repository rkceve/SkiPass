// Scaffolded from Hono's official Cloudflare Workers template:
// https://github.com/honojs/starter/tree/main/templates/cloudflare-workers (wrangler.jsonc)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skipass-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-03",
  "vars": {
    // "live" calls the real API; "mock" uses the deterministic stand-in (docs/CONTRACTS.md §5).
    "JEV_MODE": "live",
    "REVENUECAT_MODE": "live",
    // RevenueCat project for the API v2 entitlement lookup (not secret).
    "REVENUECAT_PROJECT_ID": "projc9e01f04"
  },
  "kv_namespaces": [
    {
      "binding": "USAGE",
      // Replace with the id printed by `npx wrangler kv namespace create USAGE` (see README.md).
      "id": "00000000000000000000000000000000"
    }
  ]
  // Secrets (not in this file): JEV_API_KEY, REVENUECAT_SECRET_KEY, APP_TOKEN.
  // Set with `npx wrangler secret put <NAME>`; locally use .dev.vars (see .dev.vars.example).
}
