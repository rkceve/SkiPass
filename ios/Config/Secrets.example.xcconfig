// Example build-time configuration (docs/ARCHITECTURE.md §1, Build-time configuration).
// Copy to ios/Config/Secrets.xcconfig (git-ignored) and fill in real values.
// Values in Secrets.xcconfig override these defaults.
//
// xcconfig treats "//" as a comment start, so URLs are written as "https:/$()/host".

SKIPASS_SERVER_URL = https:/$()/skipass.example.invalid
SKIPASS_APP_TOKEN = example-app-token

// Google OAuth client ID is "<GOOGLE_CLIENT_ID_PREFIX>.apps.googleusercontent.com".
// The prefix also forms the redirect scheme "com.googleusercontent.apps.<prefix>".
GOOGLE_CLIENT_ID_PREFIX = 000000000000-example
GOOGLE_CLIENT_ID = $(GOOGLE_CLIENT_ID_PREFIX).apps.googleusercontent.com

MICROSOFT_CLIENT_ID = 00000000-0000-0000-0000-000000000000
REVENUECAT_API_KEY = appl_example
